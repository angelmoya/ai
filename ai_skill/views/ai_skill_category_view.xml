<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="ai_skill_category_tree_view">
        <field name="model">ai.skill.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="parent_id" />
                <field name="skill_count" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_skill_category_form_view">
        <field name="model">ai.skill.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="parent_id" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_skill_category_act_window">
        <field name="name">Skill Categories</field>
        <field name="res_model">ai.skill.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record model="ir.ui.menu" id="ai_skill_menu_skills">
        <field name="name">Skills</field>
        <field name="parent_id" ref="ai_skill.ai_skill_menu" />
        <field name="action" ref="ai_skill_act_window" />
        <field name="sequence" eval="5" />
    </record>

    <record model="ir.ui.menu" id="ai_skill_category_menu">
        <field name="name">Categories</field>
        <field name="parent_id" ref="ai_skill.ai_skill_menu" />
        <field name="action" ref="ai_skill_category_act_window" />
        <field name="sequence" eval="10" />
    </record>
</odoo>
