<odoo>
    <record model="ir.ui.view" id="ai_call_wizard_form_view">
        <field name="model">ai.call.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="connection_id" readonly="context.get('default_connection_id') or context.get('default_session_id')" />
                    <field name="session_id" invisible="context.get('default_connection_id') or context.get('default_session_id')" />
                    <field name="prompt" />
                </group>
                <footer>
                    <button name="action_execute" type="object"
                        string="Execute" class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
