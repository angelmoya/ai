<odoo>
    <record model="ir.ui.view" id="ai_connection_call_form_view">
        <field name="model">ai.connection.call</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="connection_id" />
                        <field name="session_id" />
                        <field name="model_used" />
                        <field name="duration" />
                    </group>
                    <group string="Tokens">
                        <field name="prompt_tokens" />
                        <field name="completion_tokens" />
                        <field name="total_tokens" />
                    </group>
                    <notebook>
                        <page string="Prompt">
                            <field name="prompt" nolabel="1" />
                        </page>
                        <page string="Context">
                            <field name="context" nolabel="1" />
                        </page>
                        <page string="Response">
                            <field name="response" nolabel="1" />
                        </page>
                        <page string="Tool Calls" groups="base.group_system">
                            <field name="tool_calls" nolabel="1" />
                        </page>
                        <page string="Error" groups="base.group_system">
                            <field name="error" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_connection_call_list_view">
        <field name="model">ai.connection.call</field>
        <field name="arch" type="xml">
            <list>
                <field name="connection_id" />
                <field name="prompt" />
                <field name="state" />
                <field name="total_tokens" />
                <field name="model_used" />
                <field name="duration" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_connection_call_act_window">
        <field name="name">AI Calls</field>
        <field name="res_model">ai.connection.call</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("connection_id", "=", active_id)]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.actions.act_window" id="ai_connection_call_for_session_act_window">
        <field name="name">Calls</field>
        <field name="res_model">ai.connection.call</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("session_id", "=", active_id)]</field>
        <field name="context">{}</field>
    </record>
</odoo>
