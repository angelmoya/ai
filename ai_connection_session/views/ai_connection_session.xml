<odoo>
    <record model="ir.ui.view" id="ai_connection_session_tree_view">
        <field name="model">ai.connection.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="connection_id" />
                <field name="call_count" />
                <field name="last_call_id" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_connection_session_form">
        <field name="model">ai.connection.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_call_wizard"
                        type="object"
                        class="btn-primary"
                        string="Send Prompt"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(ai_connection_call_for_session_act_window)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-phone"
                        >
                            <field name="call_count" widget="statinfo" string="Calls" />
                        </button>
                    </div>
                    <group>
                        <field name="name" />
                        <field name="connection_id" />
                        <field name="active" />
                    </group>
                    <group string="Summary">
                        <field name="summary" nolabel="1" />
                    </group>
                    <notebook>
                        <page string="Message History">
                            <field name="message_history_formatted" nolabel="1" />
                        </page>
                        <page string="Raw Message History" groups="base.group_system">
                            <field name="message_history" nolabel="1" widget="jsonb" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_connection_session_act_window">
        <field name="name">AI Sessions</field>
        <field name="res_model">ai.connection.session</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('ai_connection_session_tree_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('ai_connection_session_form')}),
        ]"
        />
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record
        model="ir.actions.act_window"
        id="ai_connection_session_for_connection_act_window"
    >
        <field name="name">Sessions</field>
        <field name="res_model">ai.connection.session</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('ai_connection_session_tree_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('ai_connection_session_form')}),
        ]"
        />
        <field name="domain">[("connection_id", "=", active_id)]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="ai_connection_session_menu">
        <field name="name">Sessions</field>
        <field name="parent_id" ref="ai_tool.ai_menu_root" />
        <field name="action" ref="ai_connection_session_act_window" />
        <field name="sequence" eval="18" />
    </record>
</odoo>
