<odoo>
    <record model="ir.ui.view" id="ai_agent_form_view_orchestrator">
        <field name="model">ai.agent</field>
        <field name="inherit_id" ref="ai_agent.ai_agent_form_view" />
        <field name="arch" type="xml">
            <field name="planning_enabled" position="after">
                <field name="is_orchestrator" />
            </field>
            <notebook position="inside">
                <page string="Orchestrator Members" invisible="not is_orchestrator">
                    <field name="orchestrator_member_ids" nolabel="1" />
                </page>
            </notebook>
        </field>
    </record>
</odoo>
