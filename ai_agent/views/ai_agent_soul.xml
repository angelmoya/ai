<odoo>
    <record model="ir.ui.view" id="ai_agent_soul_tree_view">
        <field name="model">ai.agent.soul</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_agent_soul_form_view">
        <field name="model">ai.agent.soul</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="active" />
                    </group>
                    <group string="Personality">
                        <field name="personality" nolabel="1" />
                    </group>
                    <group string="Voice Guidelines">
                        <field name="voice_guidelines" nolabel="1" />
                    </group>
                    <group string="Values">
                        <field name="values" nolabel="1" />
                    </group>
                    <group string="Fallback Behaviour">
                        <field name="fallback_behavior" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_agent_soul_act_window">
        <field name="name">AI Agent Souls</field>
        <field name="res_model">ai.agent.soul</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
