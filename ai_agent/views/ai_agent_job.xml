<odoo>
    <record model="ir.ui.view" id="ai_agent_job_tree_view">
        <field name="model">ai.agent.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="agent_id" />
                <field name="user_id" />
                <field name="trigger_type" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_agent_job_form_view">
        <field name="model">ai.agent.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_run"
                        type="object"
                        string="Run Now"
                        class="btn-primary"
                        invisible="state == 'running'"
                    />
                    <button
                        name="action_reset"
                        type="object"
                        string="Reset"
                        invisible="state in ('pending', 'running')"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="agent_id" />
                            <field name="user_id" />
                        </group>
                        <group>
                            <field name="trigger_type" />
                            <field
                                name="cron_id"
                                invisible="trigger_type != 'scheduled'"
                            />
                            <field name="active" />
                        </group>
                    </group>
                    <group string="Prompt">
                        <field name="prompt" nolabel="1" />
                    </group>
                    <group string="Last Result">
                        <field name="last_result" nolabel="1" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_agent_job_act_window">
        <field name="name">AI Agent Jobs</field>
        <field name="res_model">ai.agent.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
