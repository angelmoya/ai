<odoo>
    <record model="ir.ui.view" id="ai_agent_plan_tree_view">
        <field name="model">ai.agent.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="agent_id" />
                <field name="user_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_agent_plan_form_view">
        <field name="model">ai.agent.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve &amp; Execute"
                        class="btn-primary"
                        invisible="state != 'pending_approval'" />
                    <button
                        name="action_reject"
                        type="object"
                        string="Reject"
                        invisible="state not in ('draft', 'pending_approval')" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="agent_id" />
                        <field name="thread_id" />
                        <field name="user_id" />
                        <field name="requires_approval" />
                    </group>
                    <group string="Goal">
                        <field name="goal" nolabel="1" />
                    </group>
                    <field name="step_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="description" />
                            <field name="tool_id" />
                            <field name="connection_id" />
                            <field name="auto_executable" />
                            <field name="state" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_agent_plan_act_window">
        <field name="name">AI Agent Plans</field>
        <field name="res_model">ai.agent.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
