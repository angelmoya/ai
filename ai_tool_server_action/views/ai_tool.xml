<odoo>
    <record model="ir.ui.view" id="ai_tool_form_view_server_action">
        <field name="model">ai.tool</field>
        <field name="inherit_id" ref="ai_tool.ai_tool_form_view" />
        <field name="arch" type="xml">
            <group position="inside">
                <field name="is_server_action" />
                <field name="server_action_id" invisible="not is_server_action" />
            </group>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_tool_tree_view_server_action">
        <field name="model">ai.tool</field>
        <field name="inherit_id" ref="ai_tool.ai_tool_tree_view" />
        <field name="arch" type="xml">
            <field name="kind" position="after">
                <field name="is_server_action" />
            </field>
        </field>
    </record>

    <menuitem
        id="ai_tool_server_action_wizard_menu"
        name="Create Tool from Server Action"
        parent="ai_tool.ai_menu_root"
        action="ai_tool_server_action_wizard_action"
        sequence="17" />
</odoo>
