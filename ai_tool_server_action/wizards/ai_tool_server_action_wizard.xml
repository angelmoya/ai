<odoo>
    <record model="ir.ui.view" id="ai_tool_server_action_wizard_form">
        <field name="model">ai.tool.server.action.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="server_action_id" />
                    <field name="name" />
                    <field name="description" />
                    <field name="model_id" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_create_tool"
                        type="object"
                        string="Create AI Tool"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_tool_server_action_wizard_action">
        <field name="name">Create AI Tool from Server Action</field>
        <field name="res_model">ai.tool.server.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
